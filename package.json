{
  "name": "dota2-inhouse-bot",
  "version": "1.0.0",
  "description": "Dota 2 Inhouse Stats Tracker Discord Bot",
  "main": "src/index.js",
  "scripts": {
    "build:parser": "bash scripts/build-parser.sh",
    "check:parser": "bash scripts/build-parser.sh --check",
    "check:a11y": "node scripts/check-a11y.js",
    "check:patch-notes": "node scripts/check-patch-notes.js",
    "dedupe:patch-notes": "node scripts/dedupe-patch-notes.js",
    "check:robots": "node scripts/build-robots-txt.js --check",
    "build:robots": "node scripts/build-robots-txt.js",
    "check:community-paywall-source": "node scripts/check-community-paywall-source.js",
    "check:money-paths": "node --test tests/moneyPathsCoverage.test.js tests/stripeWebhookAsyncPayment.test.js tests/stripeWebhookRefundsKyc.test.js tests/inhouseServerProvisioner.test.js",
    "prestart": "bash scripts/build-parser.sh",
    "start": "node src/index.js",
    "test": "node --test tests/",
    "perf:backfill": "node scripts/perf-backfill.js",
    "migrate": "node-pg-migrate -m migrations -j sql up"
  },
  "keywords": [
    "dota2",
    "discord",
    "inhouse",
    "stats"
  ],
  "author": "",
  "license": "ISC",
  "overrides": {
    "undici": "6.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "discord.js": "^14.18.0",
    "dota2-user": "^2.1.1",
    "dotaconstants": "^8.13.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^9.15.1",
    "google-spreadsheet": "^5.2.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "openai": "^6.32.0",
    "pg": "^8.20.0",
    "protobufjs": "^7.5.4",
    "ssh2": "^1.17.0",
    "steam-user": "^5.2.1",
    "stripe": "^20.4.1",
    "ts-trueskill": "^4.2.2",
    "web-push": "^3.6.7"
  }
}
