entrypoint = "index.js"
modules = ["nodejs-20", "python-3.11", "postgresql-16"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-24_11"
packages = ["jdk", "maven"]

[deployment]
run = ["sh", "-c", "bash scripts/build-parser.sh && node src/index.js"]
deploymentTarget = "vm"
ignorePorts = false

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dota2 Inhouse Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Dota2 Inhouse Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3000 node src/index.js"
waitForPort = 3000

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd web && npm run dev -- --port 5000 --host 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
SHEET_ID = "1EjFnAnEkDkbgh4gSCmP2xwTZiAlUDsCCHLsrLShhAcE"
ANNOUNCE_CHANNEL_ID = "1380084621676646453"
WEEKLY_RECAP_CHANNEL_ID = "1380084621676646453"
DEDICATED_SERVER_IP = "134.199.166.223"
DEDICATED_SERVER_PORT = "27015"
DEDICATED_SERVER_STEAM_ID = "90285031166742544"

[userenv.development]
DISABLE_STEAM = "true"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 6000

[[ports]]
localPort = 5600
externalPort = 3003

[[ports]]
localPort = 9988
externalPort = 3002

[[ports]]
localPort = 9999
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 4200

[[ports]]
localPort = 24678
externalPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
