# ============================================================
# Inhouse Stats — Community Edition — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Lines marked [REQUIRED] must be set before the bot will start.
# Lines marked [OPTIONAL] can be left blank or removed entirely.
# ============================================================


# ----------------------------------------------------------
# Database
# ----------------------------------------------------------

# [REQUIRED] PostgreSQL connection string.
# Format: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/inhouse


# ----------------------------------------------------------
# Web server
# ----------------------------------------------------------

# [REQUIRED] Long random string used to sign session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_string

# [REQUIRED] Password for the /admin panel (standard admin login).
UPLOAD_KEY=replace_with_admin_password

# [REQUIRED] Password for full superuser access and feature-flag controls.
SUPERUSER_PASSWORD=replace_with_superuser_password

# [OPTIONAL] Port the HTTP server listens on. Defaults to 5000.
PORT=5000


# ----------------------------------------------------------
# Discord bot
# ----------------------------------------------------------

# [REQUIRED] Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# [OPTIONAL] Discord user ID allowed to run owner-only bot commands
# (!perf-backfill, !backfill-pick-source, etc). Defaults to the historical
# project owner if unset — set this on a handoff. See replit.md
# "Environment variables (security-relevant)".
OWNER_DISCORD_ID=

# [OPTIONAL] Your Discord server (guild) ID.
DISCORD_GUILD_ID=

# [OPTIONAL] Default channel ID for match summaries, recaps, and announcements.
ANNOUNCE_CHANNEL_ID=

# [OPTIONAL] Comma-separated channel IDs for match stat posts.
# Falls back to ANNOUNCE_CHANNEL_ID when not set.
STATS_CHANNEL_IDS=

# [OPTIONAL] Channel ID for weekly recap posts.
# Falls back to ANNOUNCE_CHANNEL_ID when not set.
WEEKLY_RECAP_CHANNEL_ID=

# [OPTIONAL] Comma-separated channel IDs for schedule posts.
# Falls back to ANNOUNCE_CHANNEL_ID when not set.
SCHEDULE_CHANNEL_IDS=

# [OPTIONAL] Comma-separated channel IDs for patch-note posts.
# Falls back to ANNOUNCE_CHANNEL_ID when not set.
PATCH_CHANNEL_IDS=

# [OPTIONAL] Invite URL for your Discord server (shown in bot help text).
DISCORD_INVITE=

# [OPTIONAL] Voice channel ID where Dire players are moved when a game starts.
DIRE_VOICE_CHANNEL_ID=

# [OPTIONAL] Voice channel ID where Radiant players are moved when a game starts.
RADIANT_VOICE_CHANNEL_ID=

# [OPTIONAL] Discord role IDs assigned automatically based on MMR thresholds.
# Leave blank to skip automatic role assignment for that tier.
DISCORD_ROLE_GABEN=
DISCORD_ROLE_PRIMEPICK=
DISCORD_ROLE_APEX=
DISCORD_ROLE_VETERAN=
DISCORD_ROLE_SOLID=
DISCORD_ROLE_AVERAGE=
DISCORD_ROLE_NPC=
DISCORD_ROLE_ANCHOR=
DISCORD_ROLE_NEUTRALCREEP=
DISCORD_ROLE_OBSERVERWARD=
DISCORD_ROLE_POSITION6=


# ----------------------------------------------------------
# Steam
# ----------------------------------------------------------

# [REQUIRED] Steam account username used for lobby creation and rank sync.
STEAM_ACCOUNT=your_steam_username

# [REQUIRED] Steam account password.
STEAM_PASSWORD=your_steam_password

# [OPTIONAL] Steam Mobile Authenticator shared secret for 2FA login.
# Only needed if the Steam account has 2FA enabled.
STEAM_SHARED_SECRET=

# [OPTIONAL] Steam Web API key for Dota 2 rank lookups.
# Obtain one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# [OPTIONAL] Comma-separated Steam64 IDs trusted to invite the bot to lobbies.
TRUSTED_STEAM_IDS=


# ----------------------------------------------------------
# Google Sheets (optional stats sync)
# ----------------------------------------------------------

# [OPTIONAL] Google Sheet ID to sync stats into.
# This is the long ID in the sheet URL: /spreadsheets/d/<ID>/edit
SHEET_ID=

# [OPTIONAL] Google service account email for Sheets authentication.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# [OPTIONAL] RSA private key for the Google service account.
# Paste the full PEM key including header/footer lines.
GOOGLE_PRIVATE_KEY=


# ----------------------------------------------------------
# Dedicated game server (optional)
# ----------------------------------------------------------

# [OPTIONAL] IP address of a dedicated Dota 2 server.
DEDICATED_SERVER_IP=

# [OPTIONAL] Game server port (default: 27015).
DEDICATED_SERVER_PORT=27015

# [OPTIONAL] Steam ID of the dedicated server.
DEDICATED_SERVER_STEAM_ID=

# [OPTIONAL] RCON password for the dedicated server.
DEDICATED_SERVER_RCON_PASSWORD=

# [OPTIONAL] SSH host for the dedicated server (defaults to DEDICATED_SERVER_IP).
DEDICATED_SERVER_SSH_HOST=

# [OPTIONAL] SSH port (default: 22).
DEDICATED_SERVER_SSH_PORT=22

# [OPTIONAL] SSH user on the dedicated server (default: root).
DEDICATED_SERVER_SSH_USER=root

# [OPTIONAL] PEM-encoded SSH private key for connecting to the dedicated server.
DEDICATED_SERVER_SSH_PRIVATE_KEY=

# [OPTIONAL] Directory on the dedicated server where replay (.dem) files are stored.
DEDICATED_SERVER_REPLAY_DIR=/opt/dota2/game/dota/replays

# [OPTIONAL] Local path to store downloaded .dem replay files.
REPLAY_STORE_DIR=


# ----------------------------------------------------------
# Advanced / developer options
# ----------------------------------------------------------

# [OPTIONAL] Public base URL of your deployment (used in outbound links and emails).
# Example: https://inhouse.yourdomain.com
SITE_URL=

# [OPTIONAL] Comma-separated origins allowed for CORS requests.
# Only needed when the frontend is served from a different domain than the API.
# Example: https://frontend.yourdomain.com,https://staging.yourdomain.com
CORS_ALLOWED_ORIGINS=

# [OPTIONAL] Number of days to retain uploaded replay (.dem) files before deletion.
# Set to 0 (default) to keep replays indefinitely.
REPLAY_STORE_DAYS=0

# [OPTIONAL] Set to "true" to post patch-note announcements to Discord.
# Leave unset (or set to anything else) to suppress patch-note posts — useful
# in development and staging environments.
ANNOUNCE_PATCH_NOTES=

# [OPTIONAL] Set to "true" to skip Steam login entirely (disables lobby creation
# and rank sync). Useful for local development without a Steam account.
DISABLE_STEAM=
